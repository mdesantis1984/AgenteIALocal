<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>AgenteIALocal.Localization</AssemblyName>
    <RootNamespace>AgenteIALocal.Localization</RootNamespace>
    <!-- NUEVO - ID: 20260125_003100 - Strong name signing (requerido por VSIX firmado) -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\AgenteIALocalVSIX\key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- MODIFICADO - ID: 20260123_210100 - ROLLBACK System.Text.Json \u2192 Newtonsoft.Json -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!-- NUEVO - ID: 20260125_003200 - Embedded resources para idiomas -->
  <ItemGroup>
    <EmbeddedResource Include="languages\**\*.json" />
  </ItemGroup>
</Project>