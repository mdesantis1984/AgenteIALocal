<Window x:Class="AgenteIALocalVSIX.ToolWindows.AgenteIALocalConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Configuración" Height="720" Width="1024" MinHeight="720" MinWidth="1024"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#282828"
        shell:WindowChrome.IsHitTestVisibleInChrome="True">

    <!-- Make custom chrome act as window caption for dragging -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" CornerRadius="6" ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Palette / brushes -->
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FF1E1E22" />
        <SolidColorBrush x:Key="HeaderHighEmphasisBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="HeaderMediumEmphasisBrush" Color="#FF424242" />
        <SolidColorBrush x:Key="LayoutBackgroundBrush" Color="#282828" />
        <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#383838" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3FB950" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFF85149" />

        <!-- OVERRIDE hover/feedback celeste (MaterialDesign Primary Light) - ID: 20260116_113500 -->
        <!-- Removed in favor of targeted ToggleButton template; see FIX ComboBoxArrowHoverTransparent - ID: 20260116_120500 -->

        <Style x:Key="Text.Headline" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource HeaderHighEmphasisBrush}" />
        </Style>

        <!-- MODIFICADO - ID: 20260116_102100 -->
        <!-- Added missing Text.Body style to avoid XamlParseException; reuses existing header brush -->
        <Style x:Key="Text.Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource HeaderHighEmphasisBrush}" />
        </Style>

        <!-- MODIFICADO - ID: 20260116_112500 -->
        <!-- Replace sidebar nav template with a minimal ToggleButton-based ControlTemplate to avoid theme overlays (hover/pressed/focus) -->
        <Style x:Key="SidebarNavToggleStyle" TargetType="{x:Type ToggleButton}">
          <Setter Property="OverridesDefaultStyle" Value="True" />
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Foreground" Value="{StaticResource HeaderHighEmphasisBrush}" />
          <Setter Property="Padding" Value="8" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="12,8">
                  <ContentPresenter HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                  </Trigger>

                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="IsMouseOver" Value="True" />
                      <Condition Property="IsChecked" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource HeaderHighEmphasisBrush}" />
                  </MultiTrigger>

                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="IsPressed" Value="True" />
                      <Condition Property="IsChecked" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource HeaderHighEmphasisBrush}" />
                  </MultiTrigger>

                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="IsKeyboardFocusWithin" Value="True" />
                      <Condition Property="IsChecked" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource HeaderHighEmphasisBrush}" />
                  </MultiTrigger>

                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" TargetName="Bd" Value="0.6" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>

        <!-- TextBox with rounded corners (taller for vertical alignment) -->
        <Style x:Key="UxTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HeaderHighEmphasisBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HeaderMediumEmphasisBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10,14,10" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Use Padding so text aligns vertically centered -->
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary / Secondary buttons -->
        <Style x:Key="UxPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF49C45B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UxSecondaryButton" TargetType="Button" BasedOn="{StaticResource UxPrimaryButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HeaderHighEmphasisBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HeaderMediumEmphasisBrush}" />
        </Style>

        <!-- Danger Icon Button for header close -->
        <Style x:Key="UxDangerIconButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <md:PackIcon Kind="Close" Width="16" Height="16" Foreground="{StaticResource HeaderHighEmphasisBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFB53B3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark flat ComboBox with smaller arrow and item styling -->
        <Style x:Key="DarkFlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource HeaderHighEmphasisBrush}" />
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HeaderMediumEmphasisBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0,8,0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Border"
                                    Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />

                            <ContentPresenter Name="ContentSite"
                                              Grid.Column="0"
                                              Margin="16,0,4,0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center" />

                            <!-- ToggleButton: transparent background, small arrow -->
                            <!-- FIX ComboBoxArrowHoverTransparent - ID: 20260116_120500 -->
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="1"
                                          Focusable="False"
                                          OverridesDefaultStyle="True"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="28"
                                          Padding="0"
                                          FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <!-- arrow content remains as ComboBox toggle content -->
                                <Grid Width="12" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource HeaderHighEmphasisBrush}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>

                            <Popup Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource HeaderMediumEmphasisBrush}" BorderThickness="1" CornerRadius="10" Padding="6" SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True" ClipToBounds="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="32" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- Item container style for dropdown items -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="12,0,12,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{StaticResource HeaderHighEmphasisBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,4,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#332E2E2E" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource HeaderMediumEmphasisBrush}" Background="{StaticResource LayoutBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border x:Name="HeaderDragArea" Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="6,6,0,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource HeaderMediumEmphasisBrush}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderTitleText" Text="Configuración" Style="{StaticResource Text.Headline}" VerticalAlignment="Center" />
                </Grid>
             </Border>

            <!-- MODIFICADO - ID: 20260116_094500 -->
            <!-- Root shell: Header (42) / Body (*) / Footer (96) -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource HeaderBackgroundBrush}" Padding="16,16,16,16">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                        <!-- Navigation items: ToggleButtons with icon + text - mutual exclusive implemented manually - MODIFICADO - ID: 20260116_112500 -->
                        <ToggleButton x:Name="NavIdiomaToggle" IsChecked="False" Margin="0,0,0,12" Height="56" Style="{StaticResource SidebarNavToggleStyle}" Checked="NavToggle_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <md:PackIcon Kind="Translate" Width="20" Height="20" Foreground="{StaticResource HeaderHighEmphasisBrush}" />
                                <TextBlock Text="Idioma" Style="{StaticResource Text.Body}" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="NavLlmToggle" IsChecked="True" Margin="0,0,0,12" Height="56" Style="{StaticResource SidebarNavToggleStyle}" Checked="NavToggle_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <md:PackIcon Kind="Brain" Width="20" Height="20" Foreground="{StaticResource HeaderHighEmphasisBrush}" />
                                <TextBlock Text="LLM's Local" Style="{StaticResource Text.Body}" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- NUEVO - ID: 20260122_013100 - D1: Navigation entry for Logging page -->
                        <ToggleButton x:Name="NavLoggingToggle" IsChecked="False" Margin="0,0,0,0" Height="56" Style="{StaticResource SidebarNavToggleStyle}" Checked="NavToggle_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <md:PackIcon Kind="FileDocumentEdit" Width="20" Height="20" Foreground="{StaticResource HeaderHighEmphasisBrush}" />
                                <TextBlock Text="Logging" Style="{StaticResource Text.Body}" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- Main content host -->
                <Grid Grid.Column="1" Margin="24,0,0,0">
                    <!-- Idioma Page - MODIFICADO ID: 20260123_130000 - B1-B3: UniformGrid 5 cols + 15 idiomas -->
                    <Grid x:Name="IdiomaPageGrid" Visibility="Collapsed">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=NavIdiomaToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel Orientation="Vertical" Margin="16">
                            <TextBlock Text="Configuración de Idioma" Style="{StaticResource Text.Headline}" Margin="0,0,0,8" />
                            <TextBlock Text="Seleccione el idioma de la interfaz" Style="{StaticResource Text.Body}" Opacity="0.7" Margin="0,0,0,24" />

                            <UniformGrid x:Name="LanguageGrid" Columns="5" HorizontalAlignment="Left">
                                <!-- Fila 1 -->
                                <Border x:Name="Lang_esAR" Margin="0,0,8,8" Padding="12" Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="8" Width="120" Height="140">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="AR" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,8" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="Español" Style="{StaticResource Text.Body}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <RadioButton x:Name="Radio_esAR" GroupName="Language" IsChecked="True" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="Lang_enUS" Margin="0,0,8,8" Padding="12" Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="8" Width="120" Height="140">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="US" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,8" />
                                        <TextBlock Text="English" Style="{StaticResource Text.Body}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <RadioButton x:Name="Radio_enUS" GroupName="Language" IsEnabled="False" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,8" Padding="12" Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="8" Width="120" Height="140" Opacity="0.5">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="BR" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,8" />
                                        <TextBlock Text="Português" Style="{StaticResource Text.Body}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <RadioButton GroupName="Language" IsEnabled="False" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,8" Padding="12" Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="8" Width="120" Height="140" Opacity="0.5">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="FR" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,8" />
                                        <TextBlock Text="Français" Style="{StaticResource Text.Body}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <RadioButton GroupName="Language" IsEnabled="False" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,0,8" Padding="12" Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="8" Width="120" Height="140" Opacity="0.5">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="DE" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,8" />
                                        <TextBlock Text="Deutsch" Style="{StaticResource Text.Body}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <RadioButton GroupName="Language" IsEnabled="False" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <!-- LLM Local Page -->
                    <Grid x:Name="LlmLocalPageGrid">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=NavLlmToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Configuración de los proveedores locales" Style="{StaticResource Text.Headline}" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,12" />

                        <!-- Top row: Provider (left) + Run Mode (right) -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="Provider" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,6" />
                                <ComboBox x:Name="ProviderCombo_Modal" Style="{StaticResource DarkFlatComboBoxStyle}" IsEditable="False">
                                    <ComboBoxItem Content="LM Studio" />
                                    <ComboBoxItem Content="Jan" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="12,0,0,0">
                                <TextBlock Text="Run Mode" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,6" />
                                <ComboBox x:Name="RunModeCombo_Modal" Style="{StaticResource DarkFlatComboBoxStyle}" IsEditable="False">
                                    <ComboBoxItem Content="Preguntar" />
                                    <ComboBoxItem Content="Agente" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Server card -->
                        <Border Grid.Row="2" Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource HeaderMediumEmphasisBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel Orientation="Vertical" >
                                <TextBlock Text="Active Server Id" Foreground="{StaticResource HeaderHighEmphasisBrush}" />
                                <TextBox x:Name="ActiveServerIdTextBox_Modal" Style="{StaticResource UxTextBox}" />

                                <TextBlock Text="Base URL" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,10,0,0" />
                                <TextBox x:Name="ServerBaseUrlTextBox_Modal" Style="{StaticResource UxTextBox}" TextChanged="ServerBaseUrlTextBox_Modal_TextChanged" />
                                <TextBlock x:Name="ServerBaseUrlPingErrorText_Modal" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" Text="Servidor no responde (/v1/models)." Margin="0,6,0,0" />

                                <TextBlock Text="Model" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,10,0,0" />
                                <ComboBox x:Name="ServerModelCombo_Modal" Style="{StaticResource DarkFlatComboBoxStyle}" IsEditable="False" />

                                <TextBlock Text="API Key" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,10,0,0" />
                                <TextBox x:Name="ServerApiKeyTextBox_Modal" Style="{StaticResource UxTextBox}" />
                            </StackPanel>
                        </Border>

                        <!-- Checkboxes and max steps -->
                        <StackPanel Grid.Row="3" Orientation="Vertical" >
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="StreamToggle_Modal" Content="Stream" Foreground="{StaticResource HeaderHighEmphasisBrush}" Visibility="Collapsed" />
                                <CheckBox x:Name="IncludeUsageToggle_Modal" Content="Include usage" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="12,0,0,0" />
                            </StackPanel>

                            <!-- Temperature and MaxTokens controls for requestDefaults -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Temperature" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,6" />
                                    <TextBox x:Name="TemperatureTextBox_Modal" Style="{StaticResource UxTextBox}" Width="140" />
                                </StackPanel>

                                <StackPanel Orientation="Vertical" Margin="12,0,0,0">
                                    <TextBlock Text="Max tokens" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,6" />
                                    <TextBox x:Name="MaxTokensTextBox_Modal" Style="{StaticResource UxTextBox}" Width="120" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                <CheckBox x:Name="AgentIdeIntegrationToggle_Modal" Content="IDE integration" Foreground="{StaticResource HeaderHighEmphasisBrush}" />
                                <CheckBox x:Name="AgentApplyChangesToggle_Modal" Content="Apply changes" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="16,0,0,0" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                                    <TextBlock Text="Max steps" Foreground="{StaticResource HeaderHighEmphasisBrush}" VerticalAlignment="Center" Margin="20,0,8,0" />
                                    <TextBox x:Name="AgentMaxStepsTextBox_Modal" Style="{StaticResource UxTextBox}" Width="80" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                    </Grid>

                    <!-- NUEVO - ID: 20260122_013200 - D2-D5: Logging configuration page with grouped levels -->
                    <Grid x:Name="LoggingPageGrid">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=NavLoggingToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel Orientation="Vertical" Margin="0">
                            <!-- Page title -->
                            <TextBlock Text="Configuración de Logging" Style="{StaticResource Text.Headline}" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,24" />

                            <!-- D3: Master checkbox "Logging enabled" (global override) -->
                            <CheckBox x:Name="LoggingEnabledToggle_Modal" Content="Logging enabled (activa todos los niveles)" Foreground="{StaticResource HeaderHighEmphasisBrush}" FontWeight="SemiBold" Margin="0,0,0,24" />

                            <!-- D4: Basic levels group -->
                            <TextBlock Text="Basic Levels" Style="{StaticResource Text.Body}" Foreground="{StaticResource HeaderHighEmphasisBrush}" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Border Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource HeaderMediumEmphasisBrush}" BorderThickness="1" Margin="0,0,0,24">
                                <StackPanel Orientation="Vertical">
                                    <CheckBox x:Name="LoggingInformationToggle_Modal" Content="Information" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,12" />
                                    <CheckBox x:Name="LoggingWarningToggle_Modal" Content="Warning" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,12" />
                                    <CheckBox x:Name="LoggingErrorToggle_Modal" Content="Error" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,12" />
                                    <CheckBox x:Name="LoggingCriticalToggle_Modal" Content="Critical" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- D5: Advanced levels group -->
                            <TextBlock Text="Advanced Levels" Style="{StaticResource Text.Body}" Foreground="{StaticResource HeaderHighEmphasisBrush}" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Border Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource HeaderMediumEmphasisBrush}" BorderThickness="1" Margin="0,0,0,0">
                                <StackPanel Orientation="Vertical">
                                    <CheckBox x:Name="LoggingVerboseToggle_Modal" Content="Verbose" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,12" />
                                    <CheckBox x:Name="LoggingDebugToggle_Modal" Content="Debug" Foreground="{StaticResource HeaderHighEmphasisBrush}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Footer: remains docked at bottom -->
            <!-- MODIFICADO - ID: 20260116_110200 Footer adjusted button sizes and padding -->
            <Border Grid.Row="2" Background="{StaticResource FooterBackgroundBrush}" CornerRadius="0,0,6,6" BorderThickness="1,1,1,0" BorderBrush="{StaticResource HeaderMediumEmphasisBrush}" Height="72" Padding="24,12,48,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- MODIFICADO - ID: 20260116_110200: reduced button sizes and spacing -->
                        <Button x:Name="SaveButton_Modal" Content="Guardar" Click="SaveButton_Click" Style="{StaticResource UxPrimaryButton}" Width="120" Height="40" Margin="0,0,12,0" />
                        <Button x:Name="CloseButton_Modal" Content="Cancelar" Click="CloseButton_Click" Style="{StaticResource UxSecondaryButton}" Width="120" Height="40" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>