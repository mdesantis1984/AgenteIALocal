# Normaliza fin de línea de texto a LF en el repo (sin warnings). En Windows tu working copy usará LF también.
* text=auto eol=lf

# (Opcional recomendado) Archivos típicos de Windows en CRLF
*.sln     text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# Mantener binarios tal cual
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.vsix binary
*.dll binary
*.exe binary
*.pdb binary